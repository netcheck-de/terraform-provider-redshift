# The defaults create both warehouses, private networks, and all non-SSO SQL/data fixtures in one account.
# Uncomment and adjust only the optional inputs you need; passwords stay in ephemeral environment variables.
region = "eu-central-1"
# profile = "sandbox-admin"

# Naming and sizing.
# name_prefix         = "redshift-oss-e2e"
# producer_vpc_cidr   = "10.42.0.0/16"
# consumer_vpc_cidr   = "10.43.0.0/16"
# cluster_node_type   = "ra3.large"
# serverless_capacity = 4
# admin_username      = "tfadmin"
# admin_database      = "dev"

# Forward-only migration probes: apply defaults first, then opt in and keep the new setting enabled.
# table_rename_event_id          = false
# database_collation_insensitive = false
# spectrum_parquet_add_column    = false

# Revoke PUBLIC ASSUMEROLE on the consumer and grant COPY/UNLOAD explicitly.
# enable_assumerole_grant = true

# Supply an existing instance ARN to enable the managed SSO application, groups, and SQL integration.
# identity_center_instance_arn = "arn:aws:sso:::instance/ssoins-example"
# identity_store_id            = null # Looked up from the instance when omitted.
# identity_center_test_user_id = "existing-user-id"
# Map existing directory groups instead of creating example groups; their membership is never changed.
# identity_center_reader_group_name   = "existing-readers"
# identity_center_operator_group_name = "existing-operators"

# Create an external model for an Amazon Bedrock model already enabled in the consumer account and region.
# bedrock_model_id = "anthropic.claude-3-haiku-20240307-v1:0"

# Grant the grants datashare VIA DATA CATALOG to a Lake Formation account and authorize its DataCatalog/ identifier.
# lake_formation_account_id = "123456789012"

# Create a COPY JOB that loads the fixture bucket's data/ prefix, with the S3 event integration COPY JOB requires.
# copy_job = { auto = false }

# Replicate an existing Aurora or RDS source into the consumer through a zero-ETL integration (see README).
# zero_etl_source_arn      = "arn:aws:rds:eu-central-1:123456789012:cluster:orders"
# zero_etl_source_database = "orders" # PostgreSQL and Oracle sources only.
# Or create a disposable Aurora PostgreSQL Serverless v2 source instead (about 20 more minutes, Aurora charges).
# zero_etl_create_source = true
# Or create a disposable DynamoDB source with PITR and scoped export permissions.
# zero_etl_create_dynamodb_source = false

# Grant DEBUG on a federated-permissions database to the administrators of the consumer account.
# federated_debug_database = "sales_db"

# Read the reader's lockout state; warehouses without account lockout support reject SHOW USER LOCKOUT.
# user_lockouts = true

# Only read a context variable that exists in newly opened consumer-provider sessions.
# session_context_variable = null

# Optional cross-account mode: distinct profiles create separate networks and warehouses in those accounts.
# producer_profile = "producer-admin"
# consumer_profile = "consumer-admin"

# Direct probes require private connectivity or an explicit public SQL opt-in with restricted client CIDRs.
# allow_public_sql = false
# public_sql_cidrs = ["203.0.113.10/32"]
# direct_sslmode = "verify-full"

# Read-only connection probes. IAM Data API probes need no TCP connectivity; direct probes do, and direct password
# probes additionally use ephemeral TF_VAR_producer_password / TF_VAR_consumer_password (never set them here).
# connection_checks = [
#   "producer_data_api_iam", "consumer_data_api_iam",
#   "producer_direct_iam", "consumer_direct_iam",
#   "producer_direct_password", "consumer_direct_password",
# ]
